# Server port (Render overrides this in prod)
PORT=5000

# Allowed CORS origin — your Vite dev server, or your Vercel URL in prod
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. Get one from https://mongodb.com/cloud/atlas
# Example: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/centsible
MONGO_URI=

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Resend API key for budget alert emails (https://resend.com — free tier 3000/mo)
RESEND_API_KEY=

# Node environment
NODE_ENV=development
